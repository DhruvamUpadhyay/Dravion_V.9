# ============================================================
# DRAVION v.9 — Environment Variables
# Copy this to .env and fill in your keys
# ============================================================

# LLM (Ollama runs locally — no API key needed)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gemma3:4b"

# Cloud Brains (for auto/cloud/gemini modes)
GOOGLE_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Voice (optional — dormant until activated)
PICOVOICE_ACCESS_KEY=""
STT_ENGINE="google_free"
STT_LANGUAGE="en-US"

# Integrations (optional)
WEATHER_API_KEY=""
SERPAPI_KEY=""
GITHUB_TOKEN=""

# System
LOG_LEVEL="INFO"
DATA_DIR="data"
GOOGLE_APPLICATION_CREDENTIALS="gcloud-key.json"

# Gmail (get app password: Google Account > Security > 2FA > App Passwords)
GMAIL_ADDRESS=""
GMAIL_APP_PASSWORD=""

# Google Maps (enable Directions API in Google Cloud Console)
GOOGLE_MAPS_API_KEY=""
